# Example environment configuration.
#
# Copy this file to `.env` and edit the values you want to change:
#     cp .env.example .env
#
# Every setting is OPTIONAL — the app works with no .env file at all.
# `.env` is gitignored, so real values never get committed.
#
# To load it in a local shell:
#     set -a && source .env && set +a
# On hosted platforms, set these as the platform's environment variables
# (Streamlit Cloud: App settings → Secrets; Docker: docker run -e / --env-file).

# ----------------------------------------------------------------------
# App identity (shown in the browser tab and sidebar)
# ----------------------------------------------------------------------
APP_TITLE=AI Supply Chain Disruption Predictor
APP_ICON=🔗
APP_VERSION=1.0.0

# ----------------------------------------------------------------------
# File locations
# ----------------------------------------------------------------------
# Base folder for data paths (defaults to the repository root)
# SC_PROJECT_ROOT=/app

# Input data
# SC_SUPPLY_CHAIN_CSV=data/raw/supply_chain.csv
# SC_NEWS_CSV=data/raw/news_articles.csv

# Where generated CSVs are written
# SC_PROCESSED_DIR=data/processed

# Where the trained model is read from / written to
# SC_MODEL_PATH=models/disruption_xgb.joblib

# ----------------------------------------------------------------------
# Model and pipeline behavior
# ----------------------------------------------------------------------
# Hugging Face model used for news sentiment
SC_FINBERT_MODEL=ProsusAI/finbert

# Rolling window size in days for time-series features
SC_ROLLING_WINDOW=7

# Seed for reproducible splits and synthetic data
SC_RANDOM_SEED=42

# Risk score (0-100) at or above which a supplier counts as "high risk"
SC_RISK_THRESHOLD=70

# ----------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------
# Logging detail: DEBUG | INFO | WARNING | ERROR
SC_LOG_LEVEL=INFO

# Allow the dashboard to build features/train the model on demand when the
# model file is missing. Handy for hosted demos; set to false for production
# deployments where training should be a separate, controlled job.
SC_ALLOW_TRAINING_IN_APP=true

# ----------------------------------------------------------------------
# Streamlit server (usually set by the host, not here)
# ----------------------------------------------------------------------
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
