# Example Streamlit secrets file.
#
# Copy to `.streamlit/secrets.toml` for local development, or paste the
# contents into Streamlit Community Cloud → App settings → Secrets.
#
# `.streamlit/secrets.toml` is gitignored — never commit real credentials.
#
# The current app needs NO secrets to run. This file exists as the place to
# put credentials when you connect live data sources (see DEPLOYMENT.md).

# ----------------------------------------------------------------------
# Application settings (mirror the environment variables in .env.example)
# ----------------------------------------------------------------------
APP_VERSION = "1.0.0"
SC_LOG_LEVEL = "INFO"
SC_ALLOW_TRAINING_IN_APP = "true"

# ----------------------------------------------------------------------
# Future: live news ingestion
# ----------------------------------------------------------------------
# [news_api]
# api_key = "your-news-api-key"
# endpoint = "https://newsapi.org/v2/everything"

# ----------------------------------------------------------------------
# Future: ERP / database connection
# ----------------------------------------------------------------------
# [connections.supply_chain_db]
# dialect = "postgresql"
# host = "your-db-host"
# port = 5432
# database = "supply_chain"
# username = "readonly_user"
# password = "your-password"
